spring.application.name=barber-booking-api

# Local secrets (DB_USERNAME, DB_PASSWORD, JWT_SECRET, ...) can live in a git-ignored .env file.
spring.config.import=optional:file:.env[.properties]
spring.datasource.url=jdbc:postgresql://localhost:5432/barber_booking
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# Schema is managed by Flyway (src/main/resources/db/migration); Hibernate only checks it matches.
spring.jpa.hibernate.ddl-auto=validate

# Lets Flyway adopt a database that was created by Hibernate before Flyway was added.
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.jpa.show-sql=true

jwt.secret=${JWT_SECRET}
jwt.expiration=86400000

# Outgoing email. Defaults point at Mailpit from docker-compose.yml (inbox: http://localhost:8025).
spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
app.mail.from=${MAIL_FROM:no-reply@barberbooking.local}

# Base URL of the web app; verification links point to <frontend-url>/verify-email?token=...
app.frontend-url=${FRONTEND_URL:http://localhost:5173}

# API documentation and test console at /swagger-ui.html. Set SWAGGER_ENABLED=false in production.
springdoc.api-docs.enabled=${SWAGGER_ENABLED:true}
springdoc.swagger-ui.enabled=${SWAGGER_ENABLED:true}
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha

# Browser origins allowed to call the API (comma-separated). Default: the web app's dev server.
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

# Accounts made admin on startup (comma-separated emails). Register the account first, then restart.
app.admin-emails=${ADMIN_EMAILS:}

# Uploaded images: size limits and where they are kept on this machine (git-ignored).
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
app.storage.local-dir=${STORAGE_DIR:uploads}

# Behind a hosting proxy (e.g. Render) set FORWARD_HEADERS_STRATEGY=framework so the real client IP
# is used for rate limiting. Leave "none" when the app is reached directly (headers could be faked).
server.forward-headers-strategy=${FORWARD_HEADERS_STRATEGY:none}
